# ==========================================================
# KSP Crime Analytics Platform — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================================

# --- Environment ---
CATALYST_ENV=development                # development | production

# --- JWT / Auth ---
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=ksp-crime-analytics

# --- API Keys ---
DASHBOARD_READONLY_API_KEY=replace_with_readonly_key
ADMIN_API_KEY=replace_with_admin_key

# --- Catalyst ---
CATALYST_PROJECT_ID=replace_with_catalyst_project_id
CATALYST_ORG_ID=replace_with_catalyst_org_id

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# --- IP Whitelisting (comma separated CIDR ranges) ---
IP_WHITELIST=127.0.0.1/32

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://ksp-dashboard.internal.gov.in

# --- Logging / Monitoring ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Third-party (used by Member 4, referenced here only for env schema completeness) ---
ANTHROPIC_API_KEY=replace_with_anthropic_key
